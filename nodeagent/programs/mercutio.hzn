package mercutio

import bpf "m31labs.dev/horizon/runtime/kernel"

const EventBytes u32 = 16777216

type CellScopeVal struct {
    cell_lo u64
    cell_hi u64
    class u32
    fs_dev u64
	scratch_dev u64
	runtime_dev u64
}

type NetKey struct {
    cgroup_id u64
    dst_ip4 u32
    dst_port u16
    protocol u16
}

type Net6Key struct {
    cgroup_id u64
    dst_ip6_0 u32
    dst_ip6_1 u32
    dst_ip6_2 u32
    dst_ip6_3 u32
    dst_port u16
    protocol u16
}

type EventHeader struct {
    ts_ns u64
    cell_lo u64
    cell_hi u64
    cgroup_id u64
    pid u32
    ppid u32
    tgid u32
    uid u32
    seq u64
    kind u32
    verdict u32
    comm [16]u8
}

type ExecEvent struct {
    hdr EventHeader
    filename [256]u8
    argv_head [256]u8
    argv_trunc u32
    pad u32
}

type FileEvent struct {
    hdr EventHeader
    path [256]u8
    path_trunc u32
    flags u32
    mode u32
    op u32
}

type ConnectEvent struct {
    hdr EventHeader
    dst_ip4 u32
    dst_ip6 [16]u8
    dst_port u16
    family u16
    protocol u16
    pad u16
}

type DropCount struct {
    count u64
}

type ActionKey struct {
    cgroup_id u64
    pid u32
    kind u32
}

type ExecKey struct {
    dev u64
    ino u64
}

type ExecRule struct {
    verdict u32
}

type InterpreterKey struct {
    cgroup_id u64
    pid u32
}

type InterpreterGrantVal struct {
    expires_ns u64
}

type FileKey struct {
    cgroup_id u64
    dev u64
    ino u64
}

type FileRule struct {
    verdict u32
}

@max_entries(4096)
map CellScope hash[u64, CellScopeVal]

@max_entries(32768)
map NetAllow hash[NetKey, u8]

@max_entries(32768)
map Net6Allow hash[Net6Key, u8]

@max_entries(64)
map Drops percpu_hash[u32, DropCount]

@max_entries(4096)
map ActionGrant hash[ActionKey, u8]

@max_entries(32768)
map ExecRules hash[ExecKey, ExecRule]

@max_entries(4096)
map InterpreterGrant hash[InterpreterKey, InterpreterGrantVal]

@max_entries(4096)
map ToolchainGrant hash[InterpreterKey, InterpreterGrantVal]

@max_entries(65536)
map FileRules hash[FileKey, FileRule]

@max_entries(EventBytes)
map ExecEvents ringbuf[ExecEvent]

@max_entries(EventBytes)
map FileEvents ringbuf[FileEvent]

@max_entries(EventBytes)
map ConnectEvents ringbuf[ConnectEvent]

capability ExecObserve danger observe = "kernel.process.exec.observe"

capability ExecBlock danger "control,process,restart" = "kernel.process.exec.block"

capability FileBlock danger "control,filesystem,restart" = "kernel.file.open.block"

capability FileObserve danger observe = "kernel.file.open.observe"

capability ConnectBlock danger block = "kernel.network.connect.block"

capability Connect6Block danger block = "kernel.network.connect6.block"

capability ConnectObserve danger observe = "kernel.network.connect.observe"

capability Connect6Observe danger observe = "kernel.network.connect6.observe"

func bump_drop(id u32) bool {
    count := Drops.lookup(id)
    if count == nil {
        if Drops.update(id, DropCount{count: 1}) != 0 {
            return false
        }
        return true
    }
    count.count = count.count + 1
    return true
}

@capability(ExecObserve)
@tracepoint("sched:sched_process_exec")
func OnExec(ctx tracepoint.Exec) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return 0
    }
    event := ExecEvents.reserve()
    if event == nil {
        bump_drop(1)
        return 0
    }
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 1
    event.hdr.verdict = 0
	event.pad = 0
    bpf.current_comm(&event.hdr.comm)
    argv_len := bpf.current_argv(&event.argv_head)
    if argv_len < 0 || argv_len >= 256 {
        event.argv_trunc = 1
    }
    ExecEvents.submit(event)
    return 0
}

@capability(ExecBlock)
@lsm("bprm_check_security")
func GateExec(ctx lsm.Context) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return lsm.Allow
    }
    event := ExecEvents.reserve()
    if event == nil {
        bump_drop(1)
        if scope.class == 2 {
            return lsm.Allow
        }
        return lsm.Deny
    }
    verdict := u32(0)
    if lsm.bprm_filename(ctx, &event.filename) < 0 {
        event.argv_trunc = 1
    }
    exec_dev := lsm.bprm_dev(ctx)
    exec_ino := lsm.bprm_ino(ctx)
    exec_rule := ExecRules.lookup(ExecKey{dev: exec_dev, ino: exec_ino})
    interpreter_key := InterpreterKey{cgroup_id: cgroup_id, pid: bpf.current_pid()}
    if scope.class == 0 {
        verdict = 1
        if exec_rule != nil {
            if exec_rule.verdict == 1 {
                verdict = 0
            } else if exec_rule.verdict == 3 {
                verdict = 0
                if InterpreterGrant.update(interpreter_key, InterpreterGrantVal{expires_ns: bpf.ktime_get_ns() + u64(250000000)}) != 0 {
                    verdict = 1
                }
            } else if exec_rule.verdict == 4 {
                interpreter_grant := InterpreterGrant.lookup(interpreter_key)
                if interpreter_grant != nil {
                    if interpreter_grant.expires_ns >= bpf.ktime_get_ns() {
                        verdict = 0
                    }
                    if InterpreterGrant.delete(interpreter_key) != 0 {
                        verdict = 1
                    }
                }
            } else if exec_rule.verdict == 5 {
                verdict = 0
                if ToolchainGrant.update(interpreter_key, InterpreterGrantVal{expires_ns: bpf.ktime_get_ns() + u64(600000000000)}) != 0 {
                    verdict = 1
                }
            }
        }
        if verdict == 1 && (exec_dev == scope.fs_dev || exec_dev == scope.scratch_dev) {
            toolchain_key := InterpreterKey{cgroup_id: cgroup_id, pid: bpf.current_ppid()}
            toolchain_grant := ToolchainGrant.lookup(toolchain_key)
            if toolchain_grant != nil {
                if toolchain_grant.expires_ns >= bpf.ktime_get_ns() {
                    verdict = 0
                } else {
                    if ToolchainGrant.delete(toolchain_key) != 0 {
                        verdict = 1
                    }
                }
            }
        }
    } else if scope.class == 1 {
		verdict = 1
        if exec_dev == scope.fs_dev {
            verdict = 2
        } else if exec_rule != nil {
            if exec_rule.verdict == 1 {
                verdict = 0
            }
        }
    } else if exec_rule != nil {
        if exec_rule.verdict == 2 {
            verdict = 1
        }
    }
    exec_grant := ActionGrant.lookup(ActionKey{cgroup_id: cgroup_id, pid: bpf.current_pid(), kind: 1})
    if verdict == 2 && exec_grant != nil {
        verdict = 3
    }
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 1
    event.hdr.verdict = verdict
	event.pad = 1
    bpf.current_comm(&event.hdr.comm)
    ExecEvents.submit(event)
    if verdict == 1 || verdict == 2 {
        return lsm.Deny
    }
    return lsm.Allow
}

@capability(FileBlock)
@lsm("file_open")
func GateFileOpen(ctx lsm.Context) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return lsm.Allow
    }
    flags := lsm.file_flags(ctx)
    mode := lsm.file_mode(ctx)
    file_dev := lsm.file_dev(ctx)
    file_ino := lsm.file_ino(ctx)
    parent_ino := lsm.file_parent_ino(ctx)
    verdict := u32(0)
    proc_other := lsm.file_is_proc_other(ctx)
    direct_rule := FileRules.lookup(FileKey{cgroup_id: cgroup_id, dev: file_dev, ino: file_ino})
    parent_rule := FileRules.lookup(FileKey{cgroup_id: cgroup_id, dev: file_dev, ino: parent_ino})
    if proc_other {
        verdict = 1
    }
    writing := flags & (lsm.FModeWrite | lsm.OCreat | lsm.OTrunc | lsm.OAppend)
	if direct_rule != nil {
		if direct_rule.verdict == 1 {
			verdict = 1
		} else if direct_rule.verdict == 2 && writing != 0 && verdict == 0 {
			verdict = 2
		}
	}
	if parent_rule != nil {
		if parent_rule.verdict == 1 {
			verdict = 1
		} else if parent_rule.verdict == 2 && writing != 0 && verdict == 0 {
			verdict = 2
		}
	}
	writable_dev := file_dev == scope.fs_dev || file_dev == scope.scratch_dev || file_dev == scope.runtime_dev
    if writing != 0 && !writable_dev {
        verdict = 1
    }
    file_grant := ActionGrant.lookup(ActionKey{cgroup_id: cgroup_id, pid: bpf.current_pid(), kind: 2})
    if verdict == 2 && file_grant != nil {
        verdict = 3
    }
    if verdict == 0 && (bpf.ktime_get_ns() & u64(63)) != 0 {
        return lsm.Allow
    }
    event := FileEvents.reserve()
    if event == nil {
        bump_drop(2)
        if verdict == 1 || verdict == 2 {
            return lsm.Deny
        }
        if scope.class == 2 {
            return lsm.Allow
        }
        return lsm.Deny
    }
    event.flags = flags
    event.mode = mode
    if lsm.file_path(ctx, &event.path) < 0 {
        event.path_trunc = 1
    }
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 2
    event.hdr.verdict = verdict
    bpf.current_comm(&event.hdr.comm)
    FileEvents.submit(event)
    if verdict == 1 || verdict == 2 {
        return lsm.Deny
    }
    return lsm.Allow
}

@capability(FileObserve)
@lsm("file_open")
func ObserveFileOpen(ctx lsm.Context) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return lsm.Allow
    }
    event := FileEvents.reserve()
    if event == nil {
        bump_drop(2)
        return lsm.Allow
    }
    event.flags = lsm.file_flags(ctx)
    event.mode = lsm.file_mode(ctx)
    if lsm.file_path(ctx, &event.path) < 0 {
        event.path_trunc = 1
    }
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 2
    event.hdr.verdict = 0
    bpf.current_comm(&event.hdr.comm)
    FileEvents.submit(event)
    return lsm.Allow
}

@capability(ConnectBlock)
@cgroup("connect4")
func GateConnect4(ctx cgroup.Connect) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return cgroup.Allow
    }
    ip := cgroup.dst_ip4(ctx)
    port := cgroup.dst_port(ctx)
    protocol := cgroup.protocol(ctx)
    verdict := u32(0)
    if ip == cgroup.ip4(169, 254, 169, 254) {
        verdict = 1
    }
    key := NetKey{cgroup_id: cgroup_id, dst_ip4: ip, dst_port: port, protocol: u16(protocol)}
    allowed := NetAllow.lookup(key)
    if allowed == nil {
        private_net := (ip & cgroup.ip4(255, 0, 0, 0)) == cgroup.ip4(10, 0, 0, 0) || (ip & cgroup.ip4(255, 192, 0, 0)) == cgroup.ip4(100, 64, 0, 0) || (ip & cgroup.ip4(255, 0, 0, 0)) == cgroup.ip4(127, 0, 0, 0) || (ip & cgroup.ip4(255, 240, 0, 0)) == cgroup.ip4(172, 16, 0, 0) || (ip & cgroup.ip4(255, 255, 0, 0)) == cgroup.ip4(192, 168, 0, 0) || (ip & cgroup.ip4(255, 255, 0, 0)) == cgroup.ip4(169, 254, 0, 0) || (ip & cgroup.ip4(240, 0, 0, 0)) == cgroup.ip4(224, 0, 0, 0)
        if private_net {
            verdict = 1
        } else if scope.class == 1 {
            verdict = 2
        } else if scope.class == 0 {
            verdict = 1
        }
    }
    net_grant := ActionGrant.lookup(ActionKey{cgroup_id: cgroup_id, pid: bpf.current_pid(), kind: 3})
    if verdict == 2 && net_grant != nil {
        verdict = 3
    }
    event := ConnectEvents.reserve()
    if event == nil {
        bump_drop(3)
        if verdict == 1 || verdict == 2 {
            return cgroup.Deny
        }
        return cgroup.Allow
    }
    event.dst_ip4 = ip
    event.dst_port = port
    event.family = u16(cgroup.family(ctx))
    event.protocol = u16(protocol)
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 3
    event.hdr.verdict = verdict
    bpf.current_comm(&event.hdr.comm)
    ConnectEvents.submit(event)
    if verdict == 1 || verdict == 2 {
        return cgroup.Deny
    }
    return cgroup.Allow
}

@capability(ConnectObserve)
@cgroup("connect4")
func ObserveConnect4(ctx cgroup.Connect) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return cgroup.Allow
    }
    event := ConnectEvents.reserve()
    if event == nil {
        bump_drop(3)
        return cgroup.Allow
    }
    event.dst_ip4 = cgroup.dst_ip4(ctx)
    event.dst_port = cgroup.dst_port(ctx)
    event.family = u16(cgroup.family(ctx))
    event.protocol = u16(cgroup.protocol(ctx))
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 3
    event.hdr.verdict = 0
    bpf.current_comm(&event.hdr.comm)
    ConnectEvents.submit(event)
    return cgroup.Allow
}

@capability(Connect6Block)
@cgroup("connect6")
func GateConnect6(ctx cgroup.Connect) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return cgroup.Allow
    }
    event := ConnectEvents.reserve()
    if event == nil {
        bump_drop(3)
        if scope.class != 2 {
            return cgroup.Deny
        }
        return cgroup.Allow
    }
    if cgroup.dst_ip6(ctx, &event.dst_ip6) != 0 {
        ConnectEvents.discard(event)
        if scope.class != 2 {
            return cgroup.Deny
        }
        return cgroup.Allow
    }
    port := cgroup.dst_port(ctx)
    protocol := cgroup.protocol(ctx)
    verdict := u32(0)
    word0 := cgroup.dst_ip6_word(ctx, 0)
    word1 := cgroup.dst_ip6_word(ctx, 1)
    word2 := cgroup.dst_ip6_word(ctx, 2)
    word3 := cgroup.dst_ip6_word(ctx, 3)
    key := Net6Key{cgroup_id: cgroup_id, dst_ip6_0: word0, dst_ip6_1: word1, dst_ip6_2: word2, dst_ip6_3: word3, dst_port: port, protocol: u16(protocol)}
    allowed := Net6Allow.lookup(key)
    if allowed == nil {
        private_net := (word0 & u32(254)) == u32(252) || (word0 & u32(49407)) == u32(33022) || (word0 & u32(255)) == u32(255) || (word0 == 0 && word1 == 0 && word2 == 0 && (word3 == 0 || word3 == u32(16777216)))
        if private_net {
            verdict = 1
        } else if scope.class == 1 {
            verdict = 2
        } else if scope.class == 0 {
            verdict = 1
        }
    }
    net6_grant := ActionGrant.lookup(ActionKey{cgroup_id: cgroup_id, pid: bpf.current_pid(), kind: 3})
    if verdict == 2 && net6_grant != nil {
        verdict = 3
    }
    event.dst_port = port
    event.family = u16(cgroup.family(ctx))
    event.protocol = u16(protocol)
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 3
    event.hdr.verdict = verdict
    bpf.current_comm(&event.hdr.comm)
    ConnectEvents.submit(event)
    if verdict == 1 || verdict == 2 {
        return cgroup.Deny
    }
    return cgroup.Allow
}

@capability(Connect6Observe)
@cgroup("connect6")
func ObserveConnect6(ctx cgroup.Connect) i32 {
    cgroup_id := bpf.current_cgroup_id()
    scope := CellScope.lookup(cgroup_id)
    if scope == nil {
        return cgroup.Allow
    }
    event := ConnectEvents.reserve()
    if event == nil {
        bump_drop(3)
        return cgroup.Allow
    }
    if cgroup.dst_ip6(ctx, &event.dst_ip6) != 0 {
        ConnectEvents.discard(event)
        return cgroup.Allow
    }
    event.dst_port = cgroup.dst_port(ctx)
    event.family = u16(cgroup.family(ctx))
    event.protocol = u16(cgroup.protocol(ctx))
    event.hdr.ts_ns = bpf.ktime_get_ns()
    event.hdr.cell_lo = scope.cell_lo
    event.hdr.cell_hi = scope.cell_hi
    event.hdr.cgroup_id = cgroup_id
    event.hdr.pid = bpf.current_pid()
    event.hdr.ppid = bpf.current_ppid()
    event.hdr.tgid = event.hdr.pid
    event.hdr.uid = bpf.current_uid()
    event.hdr.kind = 3
    event.hdr.verdict = 0
    bpf.current_comm(&event.hdr.comm)
    ConnectEvents.submit(event)
    return cgroup.Allow
}
